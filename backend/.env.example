# Postgres local (servidor). No usar Supabase.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres

# Servidor
PORT=3000
NODE_ENV=production

# Reviews: token para ver/borrar reseñas (Bearer en Authorization)
REVIEWS_VIEW_TOKEN=your-secret-token

# Shortener (TinyURL u otro)
SHORTENER_API_URL=
SHORTENER_API_KEY=

# reCAPTCHA (backend usa VITE_CAPTCHA_SECRET para el secret del servidor)
VITE_CAPTCHA_SECRET=
