{
    "version": 2,
    "builds": [
        {
            "src": "index.mjs",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/users",
            "dest": "index.mjs",
            "methods": ["GET", "POST", "PUT", "DELETE"]
        },
        {
            "src": "/users/:id",
            "dest": "index.mjs",
            "methods": ["GET", "PUT", "DELETE"]
        },
        {
            "src": "/verify-recaptcha",
            "dest": "index.mjs",
            "methods": ["POST"]
        },
        {
            "src": "/verify-token",
            "dest": "index.mjs",
            "methods": ["POST"]
        },
        {
            "src": "/shortener",
            "dest": "index.mjs",
            "methods": ["GET", "POST"]
        },
        {
            "src": "/reviews",
            "dest": "index.mjs",
            "methods": ["GET", "POST", "DELETE"]
        },
        {
            "src": "/(.*)",
            "dest": "index.mjs"
        }
    ]
}